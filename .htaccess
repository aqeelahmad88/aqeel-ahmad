RewriteRule ^portfolio-details-30\.html$ /bexley-childcare [R=301,L]
RewriteRule ^portfolio-details-31\.html$ /find-book-beauty [R=301,L]
RewriteRule ^portfolio-details-32\.html$ /mygwork [R=301,L]
RewriteRule ^portfolio-details-33\.html$ /health-unity-wealth [R=301,L]

# Redirect direct requests for .html files to extensionless clean URLs (exclude index)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.html [NC]
RewriteCond %1 !^index$ [NC]
RewriteRule ^ /%1 [R=301,L]

# Clean URL rewriting - Serve .html files without extension in URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

