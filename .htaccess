RewriteRule ^portfolio-details-10\.html$ /amsons-design [R=301,L]
RewriteRule ^portfolio-details-11\.html$ /rapfit-clothing [R=301,L]
RewriteRule ^portfolio-details-12\.html$ /text2view [R=301,L]
RewriteRule ^portfolio-details-13\.html$ /route-deliveries [R=301,L]
RewriteRule ^portfolio-details-14\.html$ /casting-talent [R=301,L]
RewriteRule ^portfolio-details-15\.html$ /inky-illustration [R=301,L]
RewriteRule ^portfolio-details-16\.html$ /tyre-point [R=301,L]
RewriteRule ^portfolio-details-17\.html$ /churahi-enterprises [R=301,L]
RewriteRule ^portfolio-details-18\.html$ /epcot-pakistan [R=301,L]
RewriteRule ^portfolio-details-19\.html$ /services-of-canada [R=301,L]
RewriteRule ^portfolio-details-20\.html$ /noor-brands [R=301,L]
RewriteRule ^portfolio-details-21\.html$ /hash-phone [R=301,L]
RewriteRule ^portfolio-details-22\.html$ /out-of-the-blue-seafood-crm [R=301,L]
RewriteRule ^portfolio-details-23\.html$ /great-fame-clothing-co [R=301,L]
RewriteRule ^portfolio-details-24\.html$ /st-engineering-services [R=301,L]
RewriteRule ^portfolio-details-25\.html$ /deluxe-footwear [R=301,L]
RewriteRule ^portfolio-details-26\.html$ /vj-designs [R=301,L]
