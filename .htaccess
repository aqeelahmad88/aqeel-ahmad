# Apache / LiteSpeed Rewrite Rules for aqeel-ahmad.info
RewriteEngine On
RewriteBase /

# 301 Permanent Redirects from legacy portfolio-details-X.html to clean slugs
RewriteRule ^portfolio-details\.html$ /metal-carports-usa [R=301,L]
